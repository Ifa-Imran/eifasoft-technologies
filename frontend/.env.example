# =====================================================================
# KAIRO DAO frontend env template
# =====================================================================
# For testnet (dev.kairodao.com) the addresses below are the values
# from the May 2026 redeploy on opBNB Testnet (chainId 5611).
# For mainnet, override CHAIN_ID=204 and the on-chain addresses.
# =====================================================================

# Backend / WS endpoints (served by the same docker stack via Traefik)
NEXT_PUBLIC_BACKEND_URL=https://dev.kairodao.com
NEXT_PUBLIC_WS_URL=wss://dev.kairodao.com/ws

# Chain selection: 5611 = opBNB Testnet, 204 = opBNB Mainnet
NEXT_PUBLIC_CHAIN_ID=5611

# Optional overrides (leave blank to use defaults derived from CHAIN_ID)
NEXT_PUBLIC_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
NEXT_PUBLIC_EXPLORER_URL=https://opbnb-testnet.bscscan.com

# Contract addresses (opBNB Testnet redeploy 2026-05-17)
NEXT_PUBLIC_KAIRO_TOKEN=0x611B2c50E0BCcC99E5632c569431C39983126287
NEXT_PUBLIC_LIQUIDITY_POOL=0xf8BAd518660f515443D58dF0b56C826e111A443f
NEXT_PUBLIC_STAKING_MANAGER=0xf664bb81902E507424995fDAe182e1dA9019A904
NEXT_PUBLIC_AFFILIATE_DISTRIBUTOR=0xeFc8271Abe8a1EADd5c4D7c9903C0D092C2bEF86
NEXT_PUBLIC_CMS=0x995B0545677150d8d5Fa6374730FcB4cD400ba88
NEXT_PUBLIC_ATOMIC_P2P=0xD1ff5759206BA1468C393059d9A5205bB952953F
NEXT_PUBLIC_USDT=0xE6eab343b44B1D1Ccd8fFbf545a6e3e2425c7a18
