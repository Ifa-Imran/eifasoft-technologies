# deploy-testnet.ts: skip the Phase-5 admin-role burn so the deployer
# can run seed-from-snapshot.ts immediately afterward.
SKIP_BURN_ROLES=true

# seed-from-snapshot.ts inputs
STAKING_MANAGER_ADDRESS=
SNAPSHOT_FILE=
BATCH_SIZE=100
DRY_RUN=false
SKIP_FINALIZE=false
INCLUDE_DEPLOYER=false
